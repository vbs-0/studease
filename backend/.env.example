# Copy to backend/.env (git-ignored). Every variable is optional locally; the defaults match `db-up`.
ENV=dev
DATABASE_URL=
TEST_DATABASE_URL=
SEED=20261022

# Required when ENV=prod (the app refuses to start otherwise)
JWT_SECRET=
DEMO_PASSWORD=
CORS_ORIGINS=
APP_URL=

# Outbound mail (optional; mail is skipped when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TEST_TO=
DATA_SCALE=starter
